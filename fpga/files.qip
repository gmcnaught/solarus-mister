set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ddram.sv
set_global_assignment -name VERILOG_FILE rtl/lfsr.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cos.sv
set_global_assignment -name SYSTEMVERILOG_FILE Solarus.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/openbor_video_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/openbor_video_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/openbor_video_reader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ddr_blitter_arb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/blitter_top.sv
# VRAM demux: routes the blitter mem_* master by address (FB0/FB1 -> SDRAM P_DST,
# else DDR). Instantiated in Solarus.sv; list explicitly (don't rely on SEARCH_PATH).
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vram_demux.sv
# Pipelined compositor (comp_*) + burst engine. comp_defs.vh is resolved as an
# `include via SEARCH_PATH (do NOT add it as a compiled file — it is a macro header).
set_global_assignment -name SYSTEMVERILOG_FILE rtl/comp_mixer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/comp_src_linebuf.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/comp_dest_band.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/comp_span_setup.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/comp_pipeline.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/comp_burst.sv
# JT-T6: SDRAM framebuffer path = sdram_burst_arb over the vendored jtframe burst
# controller (replaces sdram_psx + sdram_src_arb, retired). See rtl/jtframe/PROVENANCE.md.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram_burst_arb.sv
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_burst_sdram.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_burst_mode.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_burst_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_burst_mux.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_burst_io.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_sdram64_init.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_sdram64_rfsh.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_sdram64_bank.v
set_global_assignment -name SEARCH_PATH rtl
set_global_assignment -name SEARCH_PATH rtl/jtframe
