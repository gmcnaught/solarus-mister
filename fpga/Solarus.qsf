# --------------------------------------------------------------------------
#
# MiSTer project
#
# WARNING WARNING WARNING:
# Do not add files to project in Quartus IDE! It will mess this file!
# Add the files manually to files.qip file.
#
# --------------------------------------------------------------------------

set_global_assignment -name VERILOG_MACRO "MENU_CORE=1"
set_global_assignment -name VERILOG_MACRO "SOLARUS_CORE=1"
# Solarus never sets MISTER_FB (no HPS-framebuffer palette mode -- video is
# direct RGB through the FPGA compositor), so ascal's default-on PALETTE
# generic (pal1_mem) is dead logic that was still eating routing budget and
# driving the pll_hdmi divclk domain negative (60fps campaign Phase 3a STA
# gate, ~-1.0ns across a 10-seed sweep). Drop it.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_PALETTE1=1"

set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"

set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "0"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS OFF
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name QII_AUTO_PACKED_REGISTERS "SPARSE AUTO"
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT EXTRA
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_DELAY_CHAINS_FOR_HIGH_FANOUT_INPUT_PINS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT LOW
set_global_assignment -name OPTIMIZE_POWER_DURING_SYNTHESIS OFF
set_global_assignment -name ROUTER_REGISTER_DUPLICATION ON
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
set_global_assignment -name SEED 1

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip

# Solarus user CDC clock-group constraints (timing-closure fix).
set_global_assignment -name SDC_FILE Solarus.sdc

# [#46] IOB-pack the SDRAM DQ read-capture register (jtframe burst path). The
# port-wildcard form in sys.tcl (FAST_INPUT_REGISTER -to SDRAM_DQ[*]) is silently
# IGNORED by the fitter (warnings 176250/176251), so our capture flop
# (jtframe_burst_io: dout <= sdram_dq) was left UNPACKED in the fabric on a long,
# place/route-variable interconnect -> marginal setup on the first beat after each
# SDRAM burst restart -> the flickering 64px scanout seam (#46, read-path; the
# multicycle SDC made STA report clean but never fixed the physical capture).
# Mirror jtcores' targeted pack (mister.qsf:65 targets the classic dq_ff).
# IMPORTANT: Quartus IGNORES *wildcard* fast-I/O-register destinations (warning
# 176251 — this is exactly why the SDRAM_DQ[*] port-wildcard never took, and why a
# first "*...|dout[*]" attempt also failed: fit kept the warnings and dout stayed
# core-side, duplicated dout~N, fed via Pad-To-Core delay chains). Use the EXACT
# fully-qualified node path, no wildcards, base name like jotego's dq_ff. Pure
# constraint — no RTL/latency change. Verify post-build: 176250/176251 gone + the
# Register Packing report lists this node as "Packed Register / Fast Input Register".
set_instance_assignment -name FAST_INPUT_REGISTER ON -to "emu:emu|sdram_fb_cache:fbcache|jtframe_burst_sdram:u_sdram_ctrl|jtframe_burst_io:u_io|dout" -entity sys_top

# [ARGB4444 plane bake -- LAB-overflow diagnostic, Task 3 bisection, ROUND 2]
# Round 1 (comp_pipeline:u_pipe register-duplication exemption -- see git
# history around commit 798c4e4/ef85c14) was dropped once the REAL round-1
# cause was found and fixed: comp_src_linebuf's line0/line1 arrays were
# silently losing M10K inference (0 memory bits / 32899 registers in the
# failing build vs. 32768 memory bits / 3 registers known-good) -- a
# quartus_map (Analysis & Synthesis) RAM-inference regression, fixed with an
# explicit `(* ramstyle = "no_rw_check, M10K" *)` attribute (see
# comp_src_linebuf.sv/comp_pipeline.sv, commit 33f0e1c) plus the same fix
# extended to ascal/osd/openbor_video_reader/shadowmask (2b323ed, fc603fa).
# That converged the overflow from 8437 LABs down to 4886 (device=4191, so
# ~695/~17% over) -- much closer, but not fully closed.
#
# The REMAINING gap has a DIFFERENT signature: blitter_top:blitter's own
# direct logic (not a child instance this time) balloons from 6334 to 69146
# registers, WITH NO memory-bit loss (memory bits actually rose slightly,
# consistent with the M10K fixes above landing correctly) -- so this is not
# another RAM-de-inference case. It matches the original round-1 MECHANISM
# (physical-synthesis register retiming/duplication responding to a timing-
# marginal path -- "estimated slack improvement of NNNN ps" followed by
# "Created N register duplicates" in the Fitter preparation log), just
# relocated to blitter_top's own FSM now that comp_pipeline's resource
# problem is fixed. This tracks: Task 1-3's new decode logic (c_bgcov_clear,
# bgw_argb4444, the OP_BGPLANE_WRITE S_SETUP/S_DECODE branches -- see
# blitter_top.sv around lines 291, 655-671) lives directly in blitter_top's
# single large shared FSM (one `always @(posedge clk)` block driving dozens
# of registers off shared control signals like state/c_flags/c_opcode), so a
# small combinational-depth increase on that shared block's decode path can
# plausibly tip an already-marginal path (the very same retiming pass that
# fired in round 1) into a much wider duplication response across that FSM's
# high-fanout control registers.
#
# Re-targeting the round-1 lever at the new location:
set_instance_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION OFF -to "emu:emu|blitter_top:blitter" -entity sys_top
set_instance_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING OFF -to "emu:emu|blitter_top:blitter" -entity sys_top
#
# CONFIDENCE / RISK -- read before trusting this blindly:
# - Same syntax-validity caveat as round 1: I believe (prior Quartus usage,
#   no docs access here) these two assignment names accept instance-level
#   -to scoping the same way FAST_INPUT_REGISTER does above, but this is
#   UNVERIFIED against Quartus 17.0's actual assignment set. Watch for an
#   "unknown assignment" warning, and check whether blitter_top's post-fit
#   register count actually drops back toward its 6334 baseline.
# - HIGHER STAKES than round 1's comp_pipeline target: blitter_top is the
#   command-ring/FSM module underneath MANY previously HW-validated timing
#   fixes across this project's history (#31-#59: SDRAM arbitration, tile-
#   list decode, throttle pacing, etc.), not a narrow, newly-added child like
#   comp_pipeline was. Disabling duplication/retiming for the WHOLE module
#   removes an optimization aid across ALL of blitter_top's registers, not
#   just the new Task-3 ones -- so this could trade the LAB-overflow failure
#   for a NEW TimeQuest timing failure somewhere else in that FSM that
#   happens to currently depend on retiming/duplication to close. IMPORTANT:
#   after this build, check the Fitter's TimeQuest timing summary (setup/hold
#   slack), not just the LAB count -- a fit PASS with a timing FAIL is not
#   actually progress.
# - A narrower, lower-risk alternative (if the report log has register-level
#   duplication detail -- e.g. the Fitter's "Register Duplication and
#   Retiming" report table listing which specific registers were duplicated)
#   would be to target only the actual highest-fanout register(s) driving the
#   duplication cascade, rather than the whole instance. I don't have that
#   per-register data from here; if the lead/fix-timing can pull it from the
#   real .fit.rpt, message me and I'll retarget precisely instead of module-
#   wide. bgw_argb4444 itself (blitter_top.sv:226/664) is NOT a good narrow
#   candidate on its own -- its only fanout is the single argb4444_mode port
#   on fbram_to_sdram (u_bgw), too low-fanout to plausibly be the register
#   Quartus is duplicating 281+ times; the real target is more likely one of
#   the FSM's existing wide-fanout control signals (state/c_flags/c_opcode)
#   that this diff's new decode branches pushed across a marginal threshold.
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top