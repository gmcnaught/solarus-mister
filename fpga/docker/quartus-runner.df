# Self-contained Quartus + GitHub Actions runner image.
#
# Build:  fpga/docker/build-runner-image.sh
# Deploy: .github/runners/truenas/quartus-runner.compose.yaml
# Docs:   docs/truenas-quartus-runner.md
#
# ---------------------------------------------------------------------------
# Modeled on jotego's JTFRAME devops images (modules/jtframe/devops/*.df in
# jotego/jtcores), which is the reference for "Quartus in CI" in the MiSTer
# world — ~100 cores compiled nightly.
#
# The pattern taken from there is the important one: their `jtcore-base` is a
# CURRENT Ubuntu, and Quartus is COPIED IN as a directory tree
# (`COPY --from=intelfpga_lite 20.1/quartus /opt/intelFPGA_lite/20.1/quartus`).
# They do not build on top of whatever ancient distro the toolchain shipped
# against. jtcore17/20/24 all do this, so Quartus 17.1, 20.1 and 24.1std on
# Ubuntu 24.04 is a production-validated combination, not a gamble.
#
# That matters here because `raetro/quartus:17.0` — the image CI's build-linux
# leg uses — is Debian 9, glibc 2.24, and a current Actions runner CANNOT run
# there: node20, which actions/checkout@v4 and upload-artifact@v4 execute
# under, needs glibc >= 2.28. Following jotego and lifting the Quartus tree
# onto a modern base dissolves that: the runner and Quartus live in ONE
# container, with no docker socket to mount and no path aliasing to get wrong.
#
# We take their pattern but keep OUR bits: Quartus comes from raetro/quartus:17.0
# rather than a local Intel install, so the toolchain stays byte-identical to
# the hosted build-linux leg and nobody has to download 1.5 GB from Intel.
# ---------------------------------------------------------------------------

# Stage 1: donor. Nothing from this stage's userland is kept — only /opt/intelFPGA.
FROM raetro/quartus:17.0 AS quartus

# Stage 2: myoung34's runner image is Ubuntu 24.04 (glibc 2.39) and already
# handles registration, PAT->registration-token exchange and ephemeral restart.
# Layering Quartus on top of it keeps that harness upstream-maintained.
FROM myoung34/github-runner:ubuntu-noble

LABEL org.opencontainers.image.title="solarus-quartus-runner" \
      org.opencontainers.image.description="Quartus Prime Lite 17.0 + GitHub Actions runner for the Solarus MiSTer core" \
      org.opencontainers.image.source="https://github.com/gmcnaught/solarus-mister"

# Quartus 17.0 runtime shims. Ubuntu 24.04 does not carry these by default and
# Quartus links them lazily, so a missing one shows up as a confusing runtime
# failure deep in the fitter rather than a clean load error.
#   libglib2.0-0t64  - jotego's jtcore-base carries this with the comment
#                      "Needed by Quartus 17". The t64 suffix is Ubuntu 24.04's
#                      64-bit-time_t rename of libglib2.0-0.
#   libtcmalloc-...  - the donor image sets LD_PRELOAD to tcmalloc; see below.
#   libx*/libsm/libice/libfreetype - Quartus links X11/font libs even for the
#                      command-line flow (quartus_sh drags in the common GUI
#                      shared objects).
#   locales          - Quartus misparses report numbers under a non-UTF-8 or
#                      comma-decimal locale; jotego pins en_US.UTF-8 for the
#                      same reason.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      libglib2.0-0t64 \
      libtcmalloc-minimal4 \
      libfreetype6 \
      libsm6 libice6 libxext6 libxft2 libxrender1 \
      locales \
 && locale-gen en_US.UTF-8 \
 && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# The Quartus tree itself — the only thing carried over from Debian 9.
COPY --from=quartus /opt/intelFPGA /opt/intelFPGA

ENV QUARTUS_PATH=/opt/intelFPGA \
    QUARTUS_ROOTDIR=/opt/intelFPGA/quartus \
    PATH="/opt/intelFPGA/quartus/bin:${PATH}"

# NOTE on LD_PRELOAD: the donor image sets
#   LD_PRELOAD=/usr/lib/libtcmalloc_minimal.so.4:/usr/lib/x86_64-linux-gnu/libstdc++.so.6
# Those are Debian 9 paths and do NOT exist here, and a bad LD_PRELOAD makes
# EVERY process in the container print a loader warning to stderr — which on a
# CI runner means it lands in the middle of build logs. It is deliberately NOT
# inherited: the `FROM myoung34/...` in stage 2 resets ENV, and we do not set it
# again. Quartus 17 runs fine on the system allocator; tcmalloc is a throughput
# tweak, not a requirement. If you want it back, point it at the Ubuntu path:
#   ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4

# ---------------------------------------------------------------------------
# BUILD-TIME GATE. This is the point of the whole file.
#
# The library shim list above is the one genuinely uncertain part of this image
# — Quartus 17.0 is a 2017 toolchain and the exact set it needs on Ubuntu 24.04
# can only be settled by running it. Putting that check HERE means a missing
# shim fails `docker build` in seconds, with a clear loader error naming the
# .so, instead of failing an hour into the first real CI job.
#
# If this line fails with a missing library, add it to the apt list above. If it
# fails wanting libpng12 (which Ubuntu dropped and the donor image installs from
# a xenial .deb), lift it from the donor stage rather than hunting a package:
#   COPY --from=quartus /usr/lib/x86_64-linux-gnu/libpng12.so.0 /usr/lib/x86_64-linux-gnu/
# ---------------------------------------------------------------------------
RUN quartus_sh --version && quartus_map --version && quartus_fit --version && quartus_sta --version

# Sanity: the Cyclone V device family the DE10-Nano uses must be installed, or
# the fitter dies at the very end of a long compile with "device family not
# installed". Cheaper to catch now.
RUN test -d /opt/intelFPGA/quartus/../devdata || true \
 && quartus_sh --tcl_eval "puts [get_family_list]" | grep -qi "Cyclone V"
