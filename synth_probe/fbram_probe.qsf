# FB-in-BRAM resource trial-synth — minimal Quartus settings.
# Goal: read "Total RAM Blocks: N / 553" for comp_fbram from fbram_probe.fit.summary.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY fbram_probe
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.0
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name SYSTEMVERILOG_FILE comp_fbram.sv
set_global_assignment -name SYSTEMVERILOG_FILE fbram_probe.sv
set_global_assignment -name SDC_FILE fbram_probe.sdc

# Keep the I/O off real pins so the fitter measures logic+RAM, not pin placement.
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to obs
