+++ b/include/solarus/entities/Tile.h
@@ -59,6 +59,10 @@ class Tile: public Entity {
     const TilePattern& get_tile_pattern() const;
     const std::string& get_tile_pattern_id() const;
     bool is_animated() const;
+    // [MiSTer #52] Effective per-tile tileset override (nullptr = use the
