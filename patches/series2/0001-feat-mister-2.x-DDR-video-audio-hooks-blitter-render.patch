@@ -171,7 +181,11 @@ void Sound::update_device_connection() {
     if (!is_connected) {
       Logger::info("Lost connection to audio device");
     } else {
-      if (System::now_ms() >= next_device_detection_date) {
+      if (System::now_ms() >= next_device_detection_date
+#ifdef MISTER_NATIVE_AUDIO
+          && !mister_audio_active()
+#endif
+         ) {
         // Check if this device is still the default one.
         next_device_detection_date = System::now_ms() + 1000;
 
@@ -207,11 +221,21 @@ void Sound::update_device_connection() {
   if (device == nullptr) {
     if (System::now_ms() >= next_device_detection_date) {
       // Try to connect or reconnect to an audio device.
+#ifdef MISTER_NATIVE_AUDIO
+      device = mister_audio_loopback_open();
+      if (device == nullptr) device = alcOpenDevice(nullptr);
+#else
       device = alcOpenDevice(nullptr);
+#endif
       if (device == nullptr) {
         Debug::error("Cannot open audio device");
       } else {
+#ifdef MISTER_NATIVE_AUDIO
+        context = mister_audio_active() ? mister_audio_loopback_create_context(device)
+                                        : alcCreateContext(device, nullptr);
+#else
         context = alcCreateContext(device, nullptr);
+#endif
         if (context == nullptr) {
           Debug::error("Cannot create audio context");
           alcCloseDevice(device);
@@ -599,6 +623,10 @@ void Sound::update() {
   if (device != nullptr) {
     AudioContext::update_all();
   }
+
+#ifdef MISTER_NATIVE_AUDIO
+  if (!mister_audio_thread_active()) mister_audio_pump(device);
+#endif
 }
 
