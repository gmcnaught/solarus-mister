 src/core/Map.cpp           | 20 ++++++++++++++++++++
 src/movements/Movement.cpp | 19 +++++++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/src/core/Map.cpp b/src/core/Map.cpp
index ea29e9e..352956b 100644
--- a/src/core/Map.cpp
+++ b/src/core/Map.cpp
@@ -15,6 +15,24 @@
  * with this program. If not, see <http://www.gnu.org/licenses/>.
  */
 #include "solarus/audio/Music.h"
+
+#include <time.h>
+#include "solarus/entities/EntityType.h"
+extern "C" {
+  extern volatile int       g_mister_lua_diag;
+  extern volatile long long g_me_ent_coll_ns;
+}
+namespace {
+  inline long long _me_now_ns_map() {
+    struct timespec _ts; clock_gettime(CLOCK_MONOTONIC, &_ts);
+    return (long long)_ts.tv_sec * 1000000000LL + _ts.tv_nsec;
+  }
+  struct _MeCollTimer {
+    long long t0; bool on;
+    explicit _MeCollTimer(bool en) : t0(en ? _me_now_ns_map() : 0), on(en) {}
+    ~_MeCollTimer() { if (on) g_me_ent_coll_ns += _me_now_ns_map() - t0; }
+  };
+}
