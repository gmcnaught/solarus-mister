diff --git a/src/audio/Sound.cpp b/src/audio/Sound.cpp
index 40c33e1..2cbbc08 100644
--- a/src/audio/Sound.cpp
+++ b/src/audio/Sound.cpp
@@ -25,6 +25,7 @@
 #include "solarus/core/String.h"
 #include "solarus/audio/Music.h"
 #include "solarus/audio/Sound.h"
+#include "mister_native_audio.h"
 #ifdef SOLARUS_OPENAL_EXTENSIONS_RECONNECT
 #  include <alext.h>
 #endif
@@ -208,6 +209,9 @@ void Sound::initialize(const Arguments& args) {
 
   // initialize the music system
   Music::initialize();
+#ifdef MISTER_NATIVE_AUDIO
+  mister_audio_thread_start();
+#endif
 }
 
 /**
@@ -221,8 +225,14 @@ void Sound::quit() {
     return;
   }
 
+#ifdef MISTER_NATIVE_AUDIO
+  mister_audio_thread_stop();
+#endif
   // uninitialize the music subsystem
   Music::quit();
+#ifdef MISTER_NATIVE_AUDIO
+  mister_audio_close();
+#endif
 
   // clear the sounds
   all_sounds.clear();
@@ -260,7 +270,7 @@ void Sound::update_device_connection() {
     if (!is_connected) {
       Logger::info("Lost connection to audio device");
     } else {
-      if (System::now() >= next_device_detection_date) {
+      if (System::now() >= next_device_detection_date && !mister_audio_active()) {
         // Check if this device is still the default one.
         next_device_detection_date = System::now() + 1000;
 
@@ -295,11 +305,20 @@ void Sound::update_device_connection() {
   if (device == nullptr) {
     if (System::now() >= next_device_detection_date) {
       // Try to connect or reconnect to an audio device.
+#ifdef MISTER_NATIVE_AUDIO
+      device = mister_audio_loopback_open();
+      if (device == nullptr) device = alcOpenDevice(nullptr);
+#else
       device = alcOpenDevice(nullptr);
+#endif
       if (device == nullptr) {
         Debug::error("Cannot open audio device");
       } else {
+#ifdef MISTER_NATIVE_AUDIO
+        context = mister_audio_active() ? mister_audio_loopback_create_context(device) : alcCreateContext(device, nullptr);
+#else
         context = alcCreateContext(device, nullptr);
+#endif
         if (context == nullptr) {
           Debug::error("Cannot create audio context");
           alcCloseDevice(device);
@@ -447,6 +466,10 @@ void Sound::update() {
     }
   }
 
+#ifdef MISTER_NATIVE_AUDIO
+  if (!mister_audio_thread_active()) mister_audio_pump(device);
+#endif
+
   // also update the music
   Music::update();
 }
