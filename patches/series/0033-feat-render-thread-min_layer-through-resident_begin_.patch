From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Grant McNaught <1371263+gmcnaught@users.noreply.github.com>
Date: Wed, 8 Jul 2026 20:47:29 -0400
Subject: [PATCH 33/42] feat(render): thread min_layer through
 resident_begin_frame/resident_static_before_animated

Part of restricting SOLARUS_BGPLANE's bake to the map's base layer only.
Not yet used by the renderer's bgplane logic -- that's the next commits.
---
 include/solarus/graphics/Renderer.h | 2 +-
 src/entities/Entities.cpp           | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/include/solarus/graphics/Renderer.h b/include/solarus/graphics/Renderer.h
index 4bb470f..de99329 100644
--- a/include/solarus/graphics/Renderer.h
+++ b/include/solarus/graphics/Renderer.h
@@ -79,7 +79,7 @@ public:
   // mid transition-scroll), 1 = build (walk + resident_record_batch/resident_escape),
   // 2 = fast (skip the walk; per pattern call resident_update, then resident_emit_layer
   // per layer).
-  virtual int resident_begin_frame(uintptr_t /*map_id*/, uintptr_t /*tileset_id*/) { return 0; }
+  virtual int resident_begin_frame(uintptr_t /*map_id*/, uintptr_t /*tileset_id*/, int /*min_layer*/) { return 0; }
   virtual bool resident_take_patch_turn() { return false; }
   virtual std::size_t resident_pattern_count() const { return 0; }
   virtual uintptr_t resident_pattern_token(std::size_t /*k*/) const { return 0; }
diff --git a/src/entities/Entities.cpp b/src/entities/Entities.cpp
index f5b3c0c..18d5d3c 100644
--- a/src/entities/Entities.cpp
+++ b/src/entities/Entities.cpp
@@ -1498,7 +1498,8 @@ void Entities::draw() {
     const Point vp = camera->get_top_left_xy();
     const int rmode = R.resident_begin_frame(
         reinterpret_cast<uintptr_t>(&map),
-        reinterpret_cast<uintptr_t>(&map.get_tileset()));
+        reinterpret_cast<uintptr_t>(&map.get_tileset()),
+        map.get_min_layer());
     // [static tile-list] Entities.cpp needs its own reachable copy of the default-ON flag
     // reader (see helper above); cached once, reused by the BUILD/FAST branches below.
     static const bool _tilestatic = mister_flag_default_on("SOLARUS_TILESTATIC");
