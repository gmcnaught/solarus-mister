From da8191adfd05853777eaac07985abd74786d36a9 Mon Sep 17 00:00:00 2001
From: stage4 <s4@local>
Date: Wed, 22 Jul 2026 18:00:05 -0400
Subject: [PATCH] perf(video): skip dead root->screen blit on blitter path
 (SOLARUS_SKIP_SCREEN_BLIT)

[MiSTer SW-3] Video::render's screen_surface clear+copy is ~1.8ms/frame of dead
work in the FPGA compositor path: screen_surface has no scanout consumer (overlay
uploads g_tagged_root; fabric scans out its own FB). Opt-in until HW-validated,
never skipped on the shader path.
---
 src/graphics/Video.cpp | 38 ++++++++++++++++++++++++++------------
 1 file changed, 26 insertions(+), 12 deletions(-)

diff --git a/src/graphics/Video.cpp b/src/graphics/Video.cpp
index 5b4da04..987f578 100644
--- a/src/graphics/Video.cpp
+++ b/src/graphics/Video.cpp
@@ -406,18 +406,32 @@ void render(const SurfacePtr& quest_surface) {
   const BlendMode terminal_blend =
       (mister_opaque_blits && !final_draw_with_shader) ? BlendMode::NONE : BlendMode::BLEND;
 
-  context.screen_surface->clear();
-  proxy.draw(
-        *context.screen_surface,
-        *surface_to_render,
-        DrawInfos(
-          Rectangle(surface_to_render->get_size()),
-          Point(),
-          Point(),
-          terminal_blend,
-          255,0,
-          get_output_size_no_bars()/surface_to_render->get_size(),
-          null_proxy));
+  // [MiSTer SW-3] Skip the root->screen full-frame blit on the FPGA compositor path.
+  // screen_surface has NO scanout consumer here: the MiSTer overlay uploads the ROOT
+  // surface (mister_blitter_renderer::emit_overlay_composite -> g_tagged_root) and the
+  // fabric scans out its own on-chip framebuffer -- nothing reads screen_surface for
+  // output. So this 320x240 clear+copy is ~1.8ms/frame of dead work (HW-measured, the
+  // [MiSTer draw] "composite" phase). video:on_draw draws onto screen_surface but is
+  // already invisible in MiSTer (its target is never scanned out), so nothing visible
+  // changes. Opt-in (SOLARUS_SKIP_SCREEN_BLIT=1) until HW-validated by the operator
+  // visual gate, then flip default-on; NEVER skipped on the shader path (a shader needs
+  // the screen composite).
+  static const bool mister_skip_screen_blit =
+      (std::getenv("SOLARUS_SKIP_SCREEN_BLIT") != nullptr);
+  if (!(mister_skip_screen_blit && !final_draw_with_shader)) {
+    context.screen_surface->clear();
+    proxy.draw(
+          *context.screen_surface,
+          *surface_to_render,
+          DrawInfos(
+            Rectangle(surface_to_render->get_size()),
+            Point(),
+            Point(),
+            terminal_blend,
+            255,0,
+            get_output_size_no_bars()/surface_to_render->get_size(),
+            null_proxy));
+  }
 }
 
