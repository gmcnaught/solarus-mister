+        auto _ctl = _cam->get_top_left_xy();
+        Solarus::mister_set_camera_pos(_ctl.x, _ctl.y);
+      } }
+#endif
     current_map->draw();
     const CameraPtr& camera = current_map->get_camera();
     if (camera != nullptr) {
