# Template for /mnt/tank/ci/quartus-runner/runner.env
#
# Copy to the NAS, fill in the token, then lock it down:
#
#   install -d -m 700 /mnt/tank/ci/quartus-runner
#   vi /mnt/tank/ci/quartus-runner/runner.env
#   chown root:root /mnt/tank/ci/quartus-runner/runner.env
#   chmod 600       /mnt/tank/ci/quartus-runner/runner.env
#
# This file is referenced by quartus-runner.compose.yaml's `env_file:` so the
# token never appears in the TrueNAS Apps UI (which renders `environment:`
# values in plain text on the app's edit form).
#
# NEVER commit the filled-in version. Only this .example belongs in git.

# A GitHub Personal Access Token used ONLY to mint runner registration tokens.
# The runner container exchanges it for a short-lived registration token on
# every (re)start, which is why an ephemeral runner can restart unattended.
#
#   Classic PAT : `repo` scope
#   Fine-grained: repository = gmcnaught/solarus-mister,
#                 Repository permissions -> Administration: Read and write
#
# Administration:write is what "manage self-hosted runners" maps to. It is a
# powerful scope — prefer a fine-grained token pinned to this one repository
# with an expiry, over a classic PAT that reaches every repo you own.
ACCESS_TOKEN=ghp_replace_me
