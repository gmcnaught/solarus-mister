# Scratch, build output, engine source checkout
work/
build/

# release_test.sh working state (downloaded RC zip, extracted tree, results)
_rc/

# Engine binaries + libs (rebuild via scripts/build_engine.sh)
deploy/solarus-run
deploy/libs/

# Solarus 2.x test-option closure (rebuild via scripts/build_engine2.sh +
# collect_runtime_libs.sh; docs/solarus2.md). The 2.x source checkout and build
# dir already fall under work/ and build/ above.
deploy/v2/

# Quest data — fetch via scripts/fetch_quest.sh (individually licensed)
deploy/quests/*
!deploy/quests/.gitkeep

# SD-mirror tree: ship-only artifacts (binary, libs, quests, RBF) are NOT
# committed — they are staged from build/ + deploy/ and pushed by deploy.py.
# The committed parts of games/Solarus/ are the shell scripts only.
games/Solarus/solarus-run
games/Solarus/libs/
games/Solarus/quests/*
!games/Solarus/quests/.gitkeep
_Other/*.rbf

# Compiled iverilog sim artifacts (rebuild from fpga/sim/*.sv)
*.vvp
# run_sims.sh scratch build/results dir (rm -rf'd + rebuilt every run)
fpga/sim/.simbuild/
# Sim framebuffer dumps (regenerated by tb_comp_replay / banding tools)
fpga/sim/*.bin

# OS cruft
.DS_Store
Thumbs.db
*.log
bench/blit_bench

# Python bytecode cache (scripts/, scripts/lib/, scripts/tests/)
__pycache__/
# local tooling — CCPM state, agent worktrees (never tracked)
.claude/

# headroom local proxy/memory artifacts (never tracked)
headroom_memory.db
.serena/

# LD_PROFILE raw capture (pulled from device during profiling runs)
*.profile

# ast-grep custom SystemVerilog grammar (21MB build artifact; rebuild via
# scripts/provision_ast_grep_sv.sh — issue #92)
.ast-grep/

# Screenshot captures from scripts/debug/shot_capture.sh (HW validation output).
shots/
